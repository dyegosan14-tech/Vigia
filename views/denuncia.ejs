<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <% const formDados = dados || {}; %>
  <div class="citizen-shell">
    <div class="citizen-container">
      <div class="citizen-header">
        <div class="citizen-brand-badge">
          Prefeitura do Recife &middot; <span>Conecta Recife</span>
        </div>
        <h1>Cuidando das Nossas Praças</h1>
        <p>Ajude a Prefeitura e os órgãos municipais a manter os espaços de lazer do Recife seguros, iluminados e bem conservados.</p>
      </div>

      <!-- Telefones de utilidade pública municipal -->
      <div class="citizen-phones-bar">
        <span>Guarda Municipal: <strong>153</strong></span>
        <span>EMLURB (Luz e Limpeza): <strong>156</strong></span>
        <span>Polícia Militar: <strong>190</strong></span>
        <span>SAMU: <strong>192</strong></span>
      </div>

      <% if (enviado) { %>
        <div class="success-card">
          <div class="success-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h2 style="font-family: var(--font-display); font-size: 20px; margin: 0 0 8px; color: #ffffff;">Relato Registrado com Sucesso</h2>
          <p style="color: var(--text-secondary); font-size: 13.5px; margin: 0 0 22px; line-height: 1.6;">
            A Central de Operações da Prefeitura do Recife (COP) recebeu sua mensagem e a demanda foi encaminhada para a equipe de monitoramento da praça indicada.
          </p>
          <a href="/denuncia" class="btn primary" style="padding: 10px 24px;">Registrar Outro Relato</a>
        </div>
      <% } else { %>
        <div class="privacy-banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <div>
            <strong>Canal 100% Anônimo e Gratuito:</strong> A Prefeitura do Recife respeita a sua privacidade. Não coletamos nome, e-mail, telefone ou dados de rastreamento.
          </div>
        </div>

        <form method="POST" action="/denuncia" id="form-denuncia">
          <!-- Input oculto para o tipo selecionado -->
          <input type="hidden" name="tipo" id="tipo-input" value="<%= formDados.tipo || '' %>" required>

          <div class="form-group">
            <label>1. Qual situação você gostaria de informar?</label>
            <div class="category-grid">
              <button type="button" class="category-card <%= formDados.tipo === 'Emergencia / preciso de ajuda agora' ? 'selected' : '' %>" data-tipo="Emergencia / preciso de ajuda agora" aria-pressed="<%= formDados.tipo === 'Emergencia / preciso de ajuda agora' %>">
                <span class="category-card-icon">🚨</span>
                <span class="category-card-title">Ajuda Imediata</span>
              </button>
              <button type="button" class="category-card <%= formDados.tipo === 'Iluminacao com falha' ? 'selected' : '' %>" data-tipo="Iluminacao com falha" aria-pressed="<%= formDados.tipo === 'Iluminacao com falha' %>">
                <span class="category-card-icon">💡</span>
                <span class="category-card-title">Lâmpada Apagada</span>
              </button>
              <button type="button" class="category-card <%= formDados.tipo === 'Vandalismo em equipamento' ? 'selected' : '' %>" data-tipo="Vandalismo em equipamento" aria-pressed="<%= formDados.tipo === 'Vandalismo em equipamento' %>">
                <span class="category-card-icon">🔨</span>
                <span class="category-card-title">Dano a Equipamento</span>
              </button>
              <button type="button" class="category-card <%= formDados.tipo === 'Comportamento suspeito' ? 'selected' : '' %>" data-tipo="Comportamento suspeito" aria-pressed="<%= formDados.tipo === 'Comportamento suspeito' %>">
                <span class="category-card-icon">👁️</span>
                <span class="category-card-title">Atitude Suspeita</span>
              </button>
              <button type="button" class="category-card <%= formDados.tipo === 'Outro' ? 'selected' : '' %>" data-tipo="Outro" aria-pressed="<%= formDados.tipo === 'Outro' %>">
                <span class="category-card-icon">📋</span>
                <span class="category-card-title">Outro Relato</span>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label for="praca_id">2. Em qual praça do Recife ocorreu?</label>
            <select id="praca_id" name="praca_id" class="form-control" required>
              <option value="" disabled <%= !formDados.praca_id ? 'selected' : '' %>>Selecione a praça ou parque</option>
              <% pracas.forEach((p) => { %>
                <option value="<%= p.id %>" <%= formDados.praca_id === p.id ? 'selected' : '' %>>
                  <%= p.nome %> &mdash; Bairro: <%= p.bairro %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
              <label for="descricao" style="margin-bottom: 0;">3. Detalhes ou ponto de referência (opcional)</label>
              <span id="char-count" style="font-size: 11px; color: var(--text-muted);">
                <%= (formDados.descricao || '').length %>/500
              </span>
            </div>
            <textarea id="descricao" name="descricao" rows="3" maxlength="500" class="form-control" placeholder="Ex: Próximo à área infantil, perto dos quiosques ou ponto de ônibus..."><%= formDados.descricao || '' %></textarea>
          </div>

          <% if (erro) { %>
            <div class="login-error" style="margin-bottom: 16px;"><%= erro %></div>
          <% } %>

          <button type="submit" class="btn primary" style="width: 100%; padding: 12px; font-size: 14px;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Enviar Relato à Prefeitura do Recife
          </button>
        </form>

        <div class="login-hint" style="margin-top: 18px;">
          Em situações de risco iminente à vida, ligue imediatamente para o <strong>190 (Polícia)</strong> ou <strong>153 (Guarda Municipal)</strong>.
        </div>
      <% } %>
    </div>
  </div>

  <script>
    const cards = document.querySelectorAll('.category-card');
    const inputTipo = document.getElementById('tipo-input');
    const form = document.getElementById('form-denuncia');

    cards.forEach(card => {
      card.addEventListener('click', () => {
        cards.forEach(c => c.classList.remove('selected'));
        cards.forEach(c => c.setAttribute('aria-pressed', 'false'));
        card.classList.add('selected');
        card.setAttribute('aria-pressed', 'true');
        inputTipo.value = card.getAttribute('data-tipo');
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        if (!inputTipo.value) {
          e.preventDefault();
          alert('Por favor, escolha uma das categorias de relato acima.');
          cards[0]?.focus();
        }
      });
    }

    const textarea = document.getElementById('descricao');
    const counter = document.getElementById('char-count');
    if (textarea && counter) {
      textarea.addEventListener('input', () => {
        counter.textContent = `${textarea.value.length}/500`;
      });
    }
  </script>
</body>
</html>
