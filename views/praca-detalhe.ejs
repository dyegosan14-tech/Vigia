<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <% const statusClasse = (s) => (s === 'operacional' ? 'ok' : s); %>
  <% const statusTexto = { operacional: 'Operacional', atencao: 'Atenção', critico: 'Crítico' }; %>
  <% const custoManutencao = praca.equipamentos.detalhe.reduce((s, eq) => s + eq.quantidade * (eq.custo_manutencao_unitario || 0), 0); %>

  <div class="app">
    <%- include('partials/sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-nav-toggle" id="btn-toggle-menu" aria-label="Abrir menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <div class="breadcrumb">
              <a href="/pracas">Praças Monitoradas</a>
              <span>/</span>
              <span><%= praca.nome %></span>
            </div>
            <h1 class="topbar-title" style="display: flex; align-items: center; gap: 10px;">
              <%= praca.nome %>
              <span class="status-label <%= statusClasse(praca.status) %>" style="font-size: 11px;">
                <%= statusTexto[praca.status] %>
              </span>
            </h1>
          </div>
        </div>

        <div class="topbar-right">
          <div class="telemetry-time">
            <div class="clock" id="relogio"></div>
            <div class="update-status">Bairro: <%= praca.bairro %> &middot; Recife</div>
          </div>
        </div>
      </header>

      <div class="content">
        <!-- Plaza Key Metrics -->
        <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));">
          <!-- Occupancy -->
          <div class="kpi-card accent">
            <div class="kpi-card-header">
              <span class="label">Ocupação em Tempo Real</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value"><%= praca.ocupacao_atual %></span>
              <span class="unit">%</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Fluxo comunitário</span>
            </div>
          </div>

          <!-- Equipment Health -->
          <div class="kpi-card <%= praca.equipamentos.operacionais === praca.equipamentos.total ? 'ok' : 'warn' %>">
            <div class="kpi-card-header">
              <span class="label">Saúde dos Dispositivos</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                  <line x1="6" y1="6" x2="6.01" y2="6"></line>
                  <line x1="6" y1="18" x2="6.01" y2="18"></line>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value"><%= praca.equipamentos.operacionais %></span>
              <span class="unit">/ <%= praca.equipamentos.total %> ativos</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge <%= praca.equipamentos.operacionais === praca.equipamentos.total ? 'positive' : 'negative' %>">
                <%= ((praca.equipamentos.operacionais / praca.equipamentos.total) * 100).toFixed(0) %>% operando
              </span>
            </div>
          </div>

          <!-- Perception -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Percepção de Segurança</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value"><%= praca.percepcao_seguranca %></span>
              <span class="unit">/ 10</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge positive">Pesquisa com moradores</span>
            </div>
          </div>

          <!-- Maintenance Cost -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Manutenção Estimada</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" style="font-size: 21px;">R$ <%= custoManutencao.toLocaleString('pt-BR') %></span>
              <span class="unit">/mês</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Contratos municipais</span>
            </div>
          </div>
        </div>

        <!-- Simulated CCTV Grid (Surveillance Cameras) -->
        <div class="panel" style="margin-bottom: 24px;">
          <div class="panel-header">
            <div class="panel-header-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--status-critical)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 7l-7 5 7 5V7z"></path>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
              <h2>Monitoramento de Câmeras CFTV &middot; <%= praca.nome %></h2>
            </div>
            <span class="live-badge" style="font-size: 10px;"><span class="live-pulse"></span> Feeds Ativos</span>
          </div>

          <div class="cctv-mosaic">
            <!-- Camera 1 -->
            <div class="cctv-tile">
              <div class="cctv-scanlines"></div>
              <div class="cctv-overlay-top">
                <div class="cctv-rec"><span class="rec-dot"></span> REC</div>
                <div class="cctv-cam-id">CAM-01 &middot; ALAMEDA PRINCIPAL</div>
              </div>
              <div class="cctv-center-target">
                <span class="cctv-ai-tag">IA &middot; FLUXO OK</span>
              </div>
              <div class="cctv-overlay-bottom">
                <div class="cctv-timestamp cctv-clock-sync">18/09/2026 --:--:--</div>
                <div class="cctv-live-tag">1080p &middot; 30 FPS</div>
              </div>
            </div>

            <!-- Camera 2 -->
            <div class="cctv-tile">
              <div class="cctv-scanlines"></div>
              <div class="cctv-overlay-top">
                <div class="cctv-rec"><span class="rec-dot"></span> REC</div>
                <div class="cctv-cam-id">CAM-02 &middot; ÁREA DE CONVIVÊNCIA</div>
              </div>
              <div class="cctv-center-target" style="border-color: rgba(245, 158, 11, 0.4);">
                <span class="cctv-ai-tag" style="color: var(--accent); background: rgba(245, 158, 11, 0.2);">IA &middot; SENSOR ATIVO</span>
              </div>
              <div class="cctv-overlay-bottom">
                <div class="cctv-timestamp cctv-clock-sync">18/09/2026 --:--:--</div>
                <div class="cctv-live-tag">1080p &middot; 30 FPS</div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid-2">
          <!-- Installed Equipment Details -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
                <h2>Equipamentos e Dispositivos em Campo</h2>
              </div>
              <span class="meta"><%= praca.equipamentos.detalhe.length %> tipos instalados</span>
            </div>

            <div class="equip-grid">
              <% praca.equipamentos.detalhe.forEach((eq) => {
                   const pct = eq.quantidade > 0 ? (eq.operacionais / eq.quantidade) * 100 : 0;
                   const estadoSaude = pct === 100 ? 'ok' : pct >= 50 ? 'warn' : 'critical';
                   const custoTotal = eq.quantidade * (eq.custo_manutencao_unitario || 0);
              %>
                <div class="equip-card">
                  <div class="equip-card-top">
                    <span class="equip-card-name">
                      <% if (eq.tipo.includes('Camera')) { %>📹<% } %>
                      <% if (eq.tipo.includes('Iluminacao')) { %>💡<% } %>
                      <% if (eq.tipo.includes('panico')) { %>🚨<% } %>
                      <% if (eq.tipo.includes('fluxo')) { %>📡<% } %>
                      <%= eq.tipo %>
                    </span>
                    <span class="status-label <%= estadoSaude %>" style="font-size: 11px;">
                      <%= eq.operacionais %> / <%= eq.quantidade %>
                    </span>
                  </div>
                  <div class="equip-health-bar">
                    <div class="equip-health-fill <%= estadoSaude %>" style="width: <%= pct %>%;"></div>
                  </div>
                  <div class="equip-card-footer">
                    <span>Taxa: <%= pct.toFixed(0) %>% operacional</span>
                    <span>R$ <%= custoTotal.toLocaleString('pt-BR') %>/mês</span>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Central Operational Quick Actions -->
            <div style="padding: 16px 20px; border-top: 1px solid var(--border-subtle); display: flex; gap: 10px; flex-wrap: wrap;">
              <button class="btn" onclick="alert('Alerta enviado à base da Guarda Municipal para patrulhamento preventivo em <%= praca.nome %>.')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Solicitar Ronda Municipal
              </button>
              <button class="btn" onclick="alert('Ordem de serviço de manutenção aberta no sistema integrado.')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
                Agendar Manutenção
              </button>
            </div>
          </div>

          <!-- History of Events in Plaza -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--status-critical)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h2>Histórico de Ocorrências</h2>
              </div>
              <span class="meta"><%= eventos.length %> registros</span>
            </div>
            <div class="panel-body" style="max-height: 400px; overflow-y: auto;">
              <% if (eventos.length === 0) { %>
                <div class="empty-state">Nenhum evento registrado nesta praça até o momento.</div>
              <% } %>
              <% eventos.forEach((o) => {
                   const hora = new Date(o.timestamp).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
              %>
                <div class="event-row">
                  <div class="event-top">
                    <span class="event-time"><%= hora %></span>
                    <span class="badge <%= o.severidade %>"><%= o.severidade %></span>
                    <span class="badge status-<%= o.status %>"><%= o.status.replace('_', ' ') %></span>
                    <% if (o.origem === 'cidadao') { %>
                      <span class="badge origem-cidadao">Denúncia Cidadã</span>
                    <% } %>
                  </div>
                  <div class="event-tipo"><%= o.tipo %></div>
                  <% if (o.descricao) { %>
                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                      "<%= o.descricao %>"
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
  <script>
    // Sincronização dos timestamps nas câmeras CFTV
    function atualizarCCTVTicks() {
      const elClocks = document.querySelectorAll('.cctv-clock-sync');
      const agora = new Date();
      const str = agora.toLocaleDateString('pt-BR') + ' ' + agora.toLocaleTimeString('pt-BR');
      elClocks.forEach(c => c.textContent = str);
    }
    setInterval(atualizarCCTVTicks, 1000);
    atualizarCCTVTicks();
  </script>
</body>
</html>
