<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <div class="app">
    <%- include('partials/sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-nav-toggle" id="btn-toggle-menu" aria-label="Abrir menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <h1 class="topbar-title">Fila Geral de Ocorrências</h1>
          </div>
        </div>

        <div class="topbar-right">
          <div class="telemetry-time">
            <div class="clock" id="relogio"></div>
            <div class="update-status"><%= ocorrencias.length %> incidentes listados</div>
          </div>
        </div>
      </header>

      <div class="content">
        <div class="panel">
          <!-- Filter Toolbar -->
          <form class="filters" method="GET" action="/ocorrencias">
            <div style="display: flex; align-items: center; gap: 8px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
              <span style="font-size: 13px; font-weight: 500; color: var(--text-secondary);">Filtrar por:</span>
            </div>

            <select name="praca_id" aria-label="Filtrar por praça">
              <option value="">Todas as praças</option>
              <% pracas.forEach((p) => { %>
                <option value="<%= p.id %>" <%= filtros.praca_id === p.id ? 'selected' : '' %>><%= p.nome %></option>
              <% }) %>
            </select>

            <select name="severidade" aria-label="Filtrar por severidade">
              <option value="">Qualquer severidade</option>
              <% ['baixa', 'media', 'alta', 'critica'].forEach((s) => { %>
                <option value="<%= s %>" <%= filtros.severidade === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
              <% }) %>
            </select>

            <select name="status" aria-label="Filtrar por status">
              <option value="">Qualquer status</option>
              <% ['aberto', 'em_atendimento', 'resolvido'].forEach((s) => { %>
                <option value="<%= s %>" <%= filtros.status === s ? 'selected' : '' %>><%= s.replace('_', ' ').charAt(0).toUpperCase() + s.replace('_', ' ').slice(1) %></option>
              <% }) %>
            </select>

            <button type="submit" class="btn primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              Aplicar Filtros
            </button>

            <% if (filtros.praca_id || filtros.severidade || filtros.status) { %>
              <a href="/ocorrencias" class="btn" style="color: var(--text-muted);">Limpar</a>
            <% } %>
          </form>

          <% if (ocorrencias.length === 0) { %>
            <div class="empty-state">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 12px; display: block;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              Nenhuma ocorrência encontrada para os filtros selecionados.
            </div>
          <% } else { %>
            <div style="overflow-x: auto;">
              <table class="data">
                <thead>
                  <tr>
                    <th>Data / Hora</th>
                    <th>Praça de Origem</th>
                    <th>Tipo de Incidente</th>
                    <th>Severidade</th>
                    <th>Status Atual</th>
                    <th>Canal / Origem</th>
                    <th>Tempo de Resposta</th>
                  </tr>
                </thead>
                <tbody>
                  <% ocorrencias.forEach((o) => {
                       const praca = pracas.find((p) => p.id === o.praca_id);
                       const hora = new Date(o.timestamp).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
                  %>
                    <tr>
                      <td style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);"><%= hora %></td>
                      <td>
                        <a href="/pracas/<%= o.praca_id %>" style="color: #fff; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                          </svg>
                          <%= praca ? praca.nome : o.praca_id %>
                        </a>
                      </td>
                      <td style="font-weight: 500;"><%= o.tipo %></td>
                      <td><span class="badge <%= o.severidade %>"><%= o.severidade %></span></td>
                      <td><span class="badge status-<%= o.status %>"><%= o.status.replace('_', ' ') %></span></td>
                      <td>
                        <% if (o.origem === 'cidadao') { %>
                          <span class="badge origem-cidadao">Denúncia Cidadã</span>
                        <% } else { %>
                          <span class="badge baixa">Sensor / Câmera</span>
                        <% } %>
                      </td>
                      <td style="font-family: var(--font-mono); font-size: 12.5px;">
                        <%= o.tempo_resposta_min ? o.tempo_resposta_min + ' min' : '—' %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
