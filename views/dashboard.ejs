<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <% const statusClasse = (s) => (s === 'operacional' ? 'ok' : (s || 'ok')); %>
  <% const statusTexto = { operacional: 'Operacional', atencao: 'Atenção', critico: 'Crítico' }; %>

  <div class="app">
    <%- include('partials/sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-nav-toggle" id="btn-toggle-menu" aria-label="Abrir menu" aria-expanded="false" aria-controls="app-sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <h1 class="topbar-title">Prefeitura do Recife &middot; Centro de Operações (COP)</h1>
          </div>
          <div class="cop-status-indicator">
            <span class="cop-status-dot"></span>
            Monitoramento 24h &middot; COP Recife
          </div>
        </div>

        <div class="topbar-right">
          <div class="telemetry-time">
            <div class="clock" id="relogio"></div>
            <div class="update-status" id="ultima-atualizacao">Sincronizado a cada 15s</div>
          </div>
        </div>
      </header>

      <div class="content">
        <!-- Indicadores de Gestão Pública (KPIs Cívicos) -->
        <div class="kpi-grid">
          <!-- 1. Disponibilidade -->
          <div class="kpi-card pcr-accent">
            <div class="kpi-card-header">
              <span class="label">Câmeras e Sensores Ativos</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-uptime"><%= kpis.uptimePct %></span>
              <span class="unit">%</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge positive">Disponibilidade nominal</span>
            </div>
          </div>

          <!-- 2. Ocorrências em Aberto -->
          <div class="kpi-card <%= kpis.ocorrenciasAbertas > 0 ? 'critical' : 'ok' %>">
            <div class="kpi-card-header">
              <span class="label">Chamados em Aberto</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-abertas"><%= kpis.ocorrenciasAbertas %></span>
              <span class="unit">em atendimento</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge <%= kpis.ocorrenciasAbertas > 0 ? 'negative' : 'positive' %>">
                <%= kpis.ocorrenciasAbertas > 0 ? 'Acompanhamento GMR' : 'Sem fila pendente' %>
              </span>
            </div>
          </div>

          <!-- 3. Tempo Médio -->
          <div class="kpi-card pcr-yellow">
            <div class="kpi-card-header">
              <span class="label">Tempo Médio de Atendimento</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-tempo"><%= kpis.tempoMedioResposta ?? '—' %></span>
              <span class="unit">min</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Despacho de viatura</span>
            </div>
          </div>

          <!-- 4. Ocupação Média -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Ocupação dos Espaços</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-uso"><%= kpis.usoMedio %></span>
              <span class="unit">%</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Circulação comunitária</span>
            </div>
          </div>

          <!-- 5. Percepção Cidadã -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Segurança Percebida</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-percepcao"><%= kpis.percepcaoMedia %></span>
              <span class="unit">/10</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge positive">Pesquisa Conecta Recife</span>
            </div>
          </div>

          <!-- 6. Variação Semanal -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Variação vs. 7 Dias</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-variacao">
                <% if (kpis.variacaoOcorrenciasPct === null) { %>—<% } else { %>
                  <%= kpis.variacaoOcorrenciasPct > 0 ? '+' : '' %><%= kpis.variacaoOcorrenciasPct %>%
                <% } %>
              </span>
            </div>
            <div class="kpi-footer">
              <% const isMelhor = kpis.variacaoOcorrenciasPct !== null && kpis.variacaoOcorrenciasPct <= 0; %>
              <span class="trend-badge <%= isMelhor ? 'positive' : 'negative' %>" id="kpi-variacao-badge">
                <%= isMelhor ? 'Queda nas ocorrências' : 'Aumento de registros' %>
              </span>
            </div>
          </div>

          <!-- 7. Custo EMLURB -->
          <div class="kpi-card pcr-accent">
            <div class="kpi-card-header">
              <span class="label">Conservação EMLURB / Mês</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-custo" style="font-size: 21px;">R$ <%= Number(kpis.custoManutencaoMensal || 0).toLocaleString('pt-BR') %></span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Contratos municipais</span>
            </div>
          </div>
        </div>

        <!-- Mapa Georreferenciado e Fila da Guarda Municipal -->
        <div class="grid-map-events">
          <!-- Mapa Tático Oficial -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pcr-yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
                <h2>Mapa Georreferenciado &middot; Praças do Recife</h2>
              </div>
              <span class="meta"><%= pracas.length %> perímetros municipais</span>
            </div>
            <div class="map-wrap">
              <div id="mapa-pracas"></div>
              <div class="map-legend">
                <div class="map-legend-item">
                  <span class="dot ok"></span> Operacional
                </div>
                <div class="map-legend-item">
                  <span class="dot atencao"></span> Em Atenção
                </div>
                <div class="map-legend-item">
                  <span class="dot critico"></span> Crítico
                </div>
              </div>
            </div>
          </div>

          <!-- Ocorrências Recentes e Despacho GMR -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pcr-yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <h2>Fila de Atendimento (GMR / EMLURB)</h2>
              </div>
              <span class="meta"><a href="/ocorrencias">Ver todas &rarr;</a></span>
            </div>
            <div class="panel-body" id="lista-ultimas-ocorrencias" style="max-height: 380px; overflow-y: auto;">
              <% if (!Array.isArray(ultimasOcorrencias) || ultimasOcorrencias.length === 0) { %>
                <div class="empty-state">Nenhum chamado pendente no momento.</div>
              <% } else { %>
                <% ultimasOcorrencias.forEach((o) => {
                     const praca = pracas.find((p) => p.id === o.praca_id);
                     const hora = o.timestamp ? new Date(o.timestamp).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : '—';
                %>
                  <div class="event-row">
                    <div class="event-top">
                      <span class="event-time"><%= hora %></span>
                      <span class="badge <%= o.severidade %>"><%= o.severidade %></span>
                      <span class="badge status-<%= o.status %>"><%= String(o.status || '').replace('_', ' ') %></span>
                      <% if (o.origem === 'cidadao') { %>
                        <span class="badge origem-cidadao">Conecta Recife</span>
                      <% } else { %>
                        <span class="badge baixa">Sensor COP</span>
                      <% } %>
                    </div>
                    <div class="event-tipo"><%= o.tipo %></div>
                    <div class="event-praca">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      <%= praca ? praca.nome : o.praca_id %> &middot; <%= praca ? praca.bairro : 'Recife' %>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Lista das Praças e Frequência Comunitária -->
        <div class="grid-2">
          <!-- Praças e Parques da Cidade -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pcr-blue-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <h2>Espaços Públicos Monitorados (EMLURB)</h2>
              </div>
              <span class="meta"><a href="/pracas">Gerenciar inventário &rarr;</a></span>
            </div>
            <div class="panel-body">
              <% pracas.forEach((p) => { %>
                <a class="praca-row" href="/pracas/<%= p.id %>">
                  <span class="dot <%= statusClasse(p.status) %>"></span>
                  <div class="info">
                    <div class="nome"><%= p.nome %></div>
                    <div class="bairro"><%= p.bairro %> &middot; <%= p.equipamentos?.operacionais || 0 %>/<%= p.equipamentos?.total || 0 %> dispositivos</div>
                  </div>
                  <span class="status-label <%= statusClasse(p.status) %>"><%= statusTexto[p.status] || p.status %></span>
                  <div class="occupancy-container">
                    <div class="occupancy-bar"><div class="fill" style="width: <%= p.ocupacao_atual %>%;"></div></div>
                    <span class="occupancy-pct"><%= p.ocupacao_atual %>%</span>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>

          <!-- Tendência de Frequência -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--pcr-yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <h2>Frequência Cidadã (Últimos 14 Dias)</h2>
              </div>
              <span class="meta">Estimativa diária de visitantes</span>
            </div>
            <div class="chart-wrap" style="padding: 16px 20px;">
              <canvas id="grafico-tendencia" height="130"></canvas>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      inicializarPainel({
        pracas: <%- JSON.stringify(pracas) %>,
        tendencia: <%- JSON.stringify(tendencia) %>
      });
    });
  </script>
</body>
</html>
