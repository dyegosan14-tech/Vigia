<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <% const statusClasse = (s) => (s === 'operacional' ? 'ok' : s); %>
  <% const statusTexto = { operacional: 'Operacional', atencao: 'Atenção', critico: 'Crítico' }; %>

  <div class="app">
    <%- include('partials/sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-nav-toggle" id="btn-toggle-menu" aria-label="Abrir menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <h1 class="topbar-title">Painel Geral de Operações</h1>
          </div>
          <div class="live-badge">
            <span class="live-pulse"></span>
            Telemetria Ativa
          </div>
        </div>

        <div class="topbar-right">
          <div class="telemetry-time">
            <div class="clock" id="relogio"></div>
            <div class="update-status" id="ultima-atualizacao">Sincronização a cada 15s</div>
          </div>
        </div>
      </header>

      <div class="content">
        <!-- Modular KPI Grid -->
        <div class="kpi-grid">
          <!-- KPI 1: Uptime -->
          <div class="kpi-card ok">
            <div class="kpi-card-header">
              <span class="label">Disponibilidade Geral</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-uptime"><%= kpis.uptimePct %></span>
              <span class="unit">%</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge positive">Operação nominal</span>
            </div>
          </div>

          <!-- KPI 2: Ocorrências Abertas -->
          <div class="kpi-card <%= kpis.ocorrenciasAbertas > 0 ? 'critical' : 'ok' %>">
            <div class="kpi-card-header">
              <span class="label">Ocorrências Ativas</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-abertas"><%= kpis.ocorrenciasAbertas %></span>
              <span class="unit">em fila</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge <%= kpis.ocorrenciasAbertas > 0 ? 'negative' : 'positive' %>">
                <%= kpis.ocorrenciasAbertas > 0 ? 'Requer atenção imediata' : 'Todas resolvidas' %>
              </span>
            </div>
          </div>

          <!-- KPI 3: Tempo Médio -->
          <div class="kpi-card accent">
            <div class="kpi-card-header">
              <span class="label">Tempo Médio de Resposta</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-tempo"><%= kpis.tempoMedioResposta ?? '—' %></span>
              <span class="unit">min</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Meta: &le; 15 min</span>
            </div>
          </div>

          <!-- KPI 4: Ocupação Média -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Ocupação das Praças</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-uso"><%= kpis.usoMedio %></span>
              <span class="unit">%</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Fluxo comunitário</span>
            </div>
          </div>

          <!-- KPI 5: Percepção de Segurança -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Percepção de Segurança</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-percepcao"><%= kpis.percepcaoMedia %></span>
              <span class="unit">/10</span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge positive">Índice positivo</span>
            </div>
          </div>

          <!-- KPI 6: Variação de Ocorrências -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Tendência vs. 7 Dias</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-variacao">
                <% if (kpis.variacaoOcorrenciasPct === null) { %>—<% } else { %>
                  <%= kpis.variacaoOcorrenciasPct > 0 ? '+' : '' %><%= kpis.variacaoOcorrenciasPct %>%
                <% } %>
              </span>
            </div>
            <div class="kpi-footer">
              <% const isMelhor = kpis.variacaoOcorrenciasPct !== null && kpis.variacaoOcorrenciasPct <= 0; %>
              <span class="trend-badge <%= isMelhor ? 'positive' : 'negative' %>" id="kpi-variacao-badge">
                <%= isMelhor ? 'Redução de incidentes' : 'Aumento de incidentes' %>
              </span>
            </div>
          </div>

          <!-- KPI 7: Manutenção -->
          <div class="kpi-card">
            <div class="kpi-card-header">
              <span class="label">Custo Estimado / Mês</span>
              <div class="kpi-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
            </div>
            <div class="kpi-value-row">
              <span class="value" id="kpi-custo" style="font-size: 21px;">R$ <%= kpis.custoManutencaoMensal.toLocaleString('pt-BR') %></span>
            </div>
            <div class="kpi-footer">
              <span class="trend-badge neutral">Contratos de campo</span>
            </div>
          </div>
        </div>

        <!-- Tactical Map & Latest Events Section -->
        <div class="grid-map-events">
          <!-- Tactical Map Panel -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
                <h2>Mapa Tático de Monitoramento</h2>
              </div>
              <span class="meta"><%= pracas.length %> praças mapeadas</span>
            </div>
            <div class="map-wrap">
              <div id="mapa-pracas"></div>
              <div class="map-legend">
                <div class="map-legend-item">
                  <span class="dot ok"></span> Operacional
                </div>
                <div class="map-legend-item">
                  <span class="dot atencao"></span> Atenção
                </div>
                <div class="map-legend-item">
                  <span class="dot critico"></span> Crítico
                </div>
              </div>
            </div>
          </div>

          <!-- Latest Events Panel -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--status-critical)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <h2>Ocorrências Recentes</h2>
              </div>
              <span class="meta"><a href="/ocorrencias">Ver todas &rarr;</a></span>
            </div>
            <div class="panel-body" id="lista-ultimas-ocorrencias" style="max-height: 380px; overflow-y: auto;">
              <% if (ultimasOcorrencias.length === 0) { %>
                <div class="empty-state">Nenhuma ocorrência registrada no momento.</div>
              <% } %>
              <% ultimasOcorrencias.forEach((o) => {
                   const praca = pracas.find((p) => p.id === o.praca_id);
                   const hora = new Date(o.timestamp).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
              %>
                <div class="event-row">
                  <div class="event-top">
                    <span class="event-time"><%= hora %></span>
                    <span class="badge <%= o.severidade %>"><%= o.severidade %></span>
                    <span class="badge status-<%= o.status %>"><%= o.status.replace('_', ' ') %></span>
                    <% if (o.origem === 'cidadao') { %>
                      <span class="badge origem-cidadao">Cidadão</span>
                    <% } %>
                  </div>
                  <div class="event-tipo"><%= o.tipo %></div>
                  <div class="event-praca">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <%= praca ? praca.nome : o.praca_id %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Plaza List and Trend Chart Section -->
        <div class="grid-2">
          <!-- Monitored Plazas Overview -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <h2>Status das Praças</h2>
              </div>
              <span class="meta"><a href="/pracas">Gerenciar &rarr;</a></span>
            </div>
            <div class="panel-body">
              <% pracas.forEach((p) => { %>
                <a class="praca-row" href="/pracas/<%= p.id %>">
                  <span class="dot <%= statusClasse(p.status) %>"></span>
                  <div class="info">
                    <div class="nome"><%= p.nome %></div>
                    <div class="bairro"><%= p.bairro %> &middot; <%= p.equipamentos.operacionais %>/<%= p.equipamentos.total %> equip.</div>
                  </div>
                  <span class="status-label <%= statusClasse(p.status) %>"><%= statusTexto[p.status] %></span>
                  <div class="occupancy-container">
                    <div class="occupancy-bar"><div class="fill" style="width: <%= p.ocupacao_atual %>%"></div></div>
                    <span class="occupancy-pct"><%= p.ocupacao_atual %>%</span>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>

          <!-- Trend Chart -->
          <div class="panel">
            <div class="panel-header">
              <div class="panel-header-left">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--status-info)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <h2>Fluxo Comunitário (14 Dias)</h2>
              </div>
              <span class="meta">Estimativa diária</span>
            </div>
            <div class="chart-wrap" style="padding: 16px 20px;">
              <canvas id="grafico-tendencia" height="130"></canvas>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      inicializarPainel({
        pracas: <%- JSON.stringify(pracas) %>,
        tendencia: <%- JSON.stringify(tendencia) %>
      });
    });
  </script>
</body>
</html>
