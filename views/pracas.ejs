<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo }) %>
</head>
<body>
  <% const statusClasse = (s) => (s === 'operacional' ? 'ok' : s); %>
  <% const statusTexto = { operacional: 'Operacional', atencao: 'Atenção', critico: 'Crítico' }; %>

  <div class="app">
    <%- include('partials/sidebar') %>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-nav-toggle" id="btn-toggle-menu" aria-label="Abrir menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div>
            <h1 class="topbar-title">Praças Monitoradas</h1>
          </div>
        </div>

        <div class="topbar-right">
          <div class="telemetry-time">
            <div class="clock" id="relogio"></div>
            <div class="update-status"><%= pracas.length %> perímetros ativos &middot; Recife/PE</div>
          </div>
        </div>
      </header>

      <div class="content">
        <div class="panel">
          <div class="panel-header">
            <div class="panel-header-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <h2>Catálogo de Espaços Públicos Monitorados</h2>
            </div>
            <span class="meta">Rede de vigilância integrada</span>
          </div>

          <div class="panel-body">
            <% pracas.forEach((p) => { %>
              <a class="praca-row" href="/pracas/<%= p.id %>" style="padding: 18px 24px;">
                <span class="dot <%= statusClasse(p.status) %>" style="width: 10px; height: 10px;"></span>
                <div class="info">
                  <div class="nome" style="font-size: 15px; margin-bottom: 2px;"><%= p.nome %></div>
                  <div class="bairro">
                    <%= p.bairro %> &middot; Percepção de Segurança: <strong style="color: #fff;"><%= p.percepcao_seguranca %>/10</strong>
                  </div>
                </div>

                <span class="status-label <%= statusClasse(p.status) %>"><%= statusTexto[p.status] %></span>

                <div style="font-family: var(--font-mono); font-size: 12.5px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                  </svg>
                  <%= p.equipamentos.operacionais %>/<%= p.equipamentos.total %> equip.
                </div>

                <div class="occupancy-container" style="min-width: 130px;">
                  <div class="occupancy-bar" style="width: 85px;">
                    <div class="fill" style="width: <%= p.ocupacao_atual %>%;"></div>
                  </div>
                  <span class="occupancy-pct"><%= p.ocupacao_atual %>%</span>
                </div>

                <div style="color: var(--accent); font-weight: 500; font-size: 13px; display: flex; align-items: center; gap: 4px;">
                  Monitorar
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
